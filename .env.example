# YNAB API Configuration
YNAB_API_TOKEN=your_ynab_api_token_here

# Optional: YNAB API Base URL (default: https://api.youneedabudget.com/v1)
# YNAB_BASE_URL=https://api.youneedabudget.com/v1

# Optional: Rate Limit Configuration
# RATE_LIMIT_REQUESTS=200
# RATE_LIMIT_WINDOW_MS=3600000

# Optional: where tools with an output_path argument (ynab_get_transactions,
# ynab_get_budget_month, ynab_export_transactions_csv) may write files. One or
# more directories separated by the platform path delimiter (":" on POSIX).
# Default when unset: the server's working directory and the OS temp dir.
# Pin this for any unattended/agent deployment.
# YNAB_OUTPUT_DIR=/path/to/output
